# Server settings. install.sh copies this to deploy/server.env; fill in the blanks there.
# Never commit server.env (it's git-ignored).

# POLITEMall > Calendar > Subscribe > "All Calendars and Tasks"
FEED_URL=

# Must be the same as API_KEY in your laptop's config/.env
API_KEY=

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Filled in automatically by install.sh from the server's public IP
DOMAIN=

TIMEZONE=Asia/Singapore
SYNC_INTERVAL_MINUTES=120
NOTIFY_INTERVAL_SECONDS=60
SUBMISSION_CHECK=remote
