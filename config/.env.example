# POLITEMall > Calendar > Subscribe > "All Calendars and Tasks" > copy the URL
FEED_URL=https://rplms.polite.edu.sg/d2l/le/calendar/feed/user/feed.ics?token=YOUR_TOKEN_HERE

# For offline development you can point at a downloaded file instead:
# FEED_FILE=C:/path/to/my_feed.ics

# Relative paths go inside data/
DB_PATH=duetracker.db
USER_NAME=me
TIMEZONE=Asia/Singapore

# --- REST API (python -m duetracker serve) ---
# Long random string; setup.bat generates one for you. Clients send it as X-API-Key.
API_KEY=
SYNC_INTERVAL_MINUTES=120
HOST=127.0.0.1
PORT=8000

# Hybrid mode: once the API is deployed, set its URL here on your LAPTOP so that
# `sync` pushes auto-done results to it.
# API_URL=https://your-app.example.com

# --- Telegram bot (starts with `serve`) ---
# Get a token from @BotFather. Never commit it.
TELEGRAM_BOT_TOKEN=
NOTIFY_INTERVAL_SECONDS=60
